# Music Provider (use "youtube" or "spotify")
MUSIC_PROVIDER=youtube

# LLM Provider (use "gemini" or "claude")
AMP_LLM_PROVIDER=gemini

# Spotify API (optional - only if using Spotify)
# Get from https://developer.spotify.com/dashboard
# SPOTIFY_CLIENT_ID=your_spotify_client_id
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# Google Gemini API (FREE) - Get from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Groq API (FREE, fast Llama 3) - Get from https://console.groq.com/keys
# GROQ_API_KEY=your_groq_api_key

# Anthropic Claude API (optional) - Get from https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=your_anthropic_api_key
